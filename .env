# Copy this file to .env and fill in real values. .env is gitignored - never commit real keys.

# ------------------------------------------------------------------------------
# LLM API KEYS - only the providers used in LLM_PRIMARY_MODEL/LLM_FALLBACK_MODEL_*
# below actually need a key set.
# ------------------------------------------------------------------------------
GROQ_API_KEY=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
OPENROUTER_API_KEY=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
GOOGLE_API_KEY=AIzaSyCdbW4J65yM9dPOYFniSI2jfg5RV52XyRw
# ------------------------------------------------------------------------------
# LLM MODEL SELECTION - tried in order, first one that succeeds wins.
# Format: <provider>/<model_name>, provider must be one of groq/openrouter/gemini.
# ------------------------------------------------------------------------------
LLM_PRIMARY_MODEL=groq/llama-3.1-8b-instant
LLM_FALLBACK_MODEL_1=openrouter/inclusionai/ling-3.0-flash:free
LLM_FALLBACK_MODEL_2=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL_3=gemini/gemini-2.0-flash-lite

# ------------------------------------------------------------------------------
# HALLUCINATION CHECK (tool 6 / Agent 1)
# ------------------------------------------------------------------------------
# Weighted hallucination score: 0.0 = every cited claim verified, 1.0 = every
# claim contradicted. If a run's score is ABOVE this, Agent 1 regenerates its
# analysis (up to MAX_HALLUCINATION_REGENERATIONS times) before giving up and
# returning the least-hallucinated attempt with a flag.
HALLUCINATION_THRESHOLD=0.3
MAX_HALLUCINATION_REGENERATIONS=1
